soong_namespace {
}

cc_prebuilt_library_shared {
    name: "libexynosgraphicbuffer",
    owner: "samsung",
    strip: {
        none: true,
    },
    target: {
        android_arm: {
            srcs: ["proprietary/vendor/lib/libexynosgraphicbuffer.so"],
        },
        android_arm64: {
            srcs: ["proprietary/vendor/lib64/libexynosgraphicbuffer.so"],
        },
    },
    compile_multilib: "both",
    check_elf_files: false,
    prefer: true,
    soc_specific: true,
}
